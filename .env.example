## Provider selection: openai or ollama
LLM_PROVIDER=openai

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Docker Compose reaches host Ollama through host.docker.internal.
# If ml-service runs outside Docker, use http://localhost:11434 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_GENERATE_MODEL=llama3.1

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_data_analyst
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Local Ollama reference:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_GENERATE_MODEL=llama3.1

# Production OpenAI reference:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=replace-with-a-secret
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini
