## Provider selection: openai or ollama
LLM_PROVIDER=openai
CHAT_ENABLED=false

# Required when LLM_PROVIDER=openai.
# Leave blank or disabled if the demo environment does not include a valid key.
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Docker Compose reaches host Ollama through host.docker.internal.
# If ml-service runs outside Docker, use http://localhost:11434 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_GENERATE_MODEL=llama3.1

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_data_analyst
POSTGRES_USER=ai_data_analyst
POSTGRES_PASSWORD=change-me

# Required shared service-authentication key (generate a unique value).
INTERNAL_API_KEY=change-me
JWT_SECRET=change-me
BACKEND_ORIGIN=http://localhost:8080

# Local Ollama reference:
# LLM_PROVIDER=ollama
# CHAT_ENABLED=false
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_GENERATE_MODEL=llama3.1

# Production OpenAI reference:
# LLM_PROVIDER=openai
# CHAT_ENABLED=true
# OPENAI_API_KEY=replace-with-a-secret
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini
